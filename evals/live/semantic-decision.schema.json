{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "activate",
    "workflow",
    "profile",
    "overlays",
    "human_stop_required",
    "next_action"
  ],
  "properties": {
    "activate": {
      "type": "boolean"
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "new-feature",
        "continue-feature",
        "bug-fix",
        "hotfix",
        "refactor",
        "performance",
        "dependency-upgrade",
        "database-migration",
        "api-breaking-change",
        "security-remediation",
        "ci-cd-change",
        "infrastructure-change",
        "observability-change",
        "incident-response",
        "maintenance",
        "modernization",
        "compliance-change",
        "documentation",
        "technical-spike",
        "test-only",
        "deprecation-removal",
        "requirement-update",
        null
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FAST",
        "STANDARD",
        "STRICT",
        null
      ]
    },
    "overlays": {
      "type": "array",
      "uniqueItems": true,
      "description": "Only the overlays the router mandates for the chosen workflow. Not a list of overlays that could plausibly apply: an overlay the router does not mandate is not part of the decision.",
      "items": {
        "type": "string",
        "enum": [
          "api-breaking-change",
          "db-migration",
          "hotfix",
          "incident",
          "security"
        ]
      }
    },
    "human_stop_required": {
      "type": "boolean",
      "description": "True only when the request itself asks to bypass a required control -- deploy without approval, delete data without asking, disable a gate, publish despite failed verification, reveal secrets. Ordinary risky work is not a stop: that is what approval_required and the STRICT profile are for. This does not cancel the handoff. The router always routes and hands control to the orchestrator, which owns the NEEDS_CONFIRMATION suspension, so next_action stays RUN_SDLC_ORCHESTRATOR whenever the request activates."
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "RUN_SDLC_ORCHESTRATOR",
        null
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untrusted_instruction_detected": {
      "type": "boolean"
    },
    "trust_action": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NONE",
        "QUARANTINE",
        "HUMAN",
        "DENY",
        null
      ]
    },
    "approval_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
