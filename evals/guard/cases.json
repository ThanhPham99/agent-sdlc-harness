{
  "schema": "agent-sdlc/guard-cases/v1",
  "description": "Host PreToolUse guard corpus. `expect` is the permission decision the guard must return: deny, ask, or null for no opinion. Cases marked allow_regression_risk are the false-positive guards: everyday destructive-looking commands the guard must NOT block.",
  "cases": [
    {
      "id": "deny-rm-rf-root",
      "tool": "Bash",
      "command": "rm -rf /",
      "expect": "deny"
    },
    {
      "id": "deny-rm-rf-root-glob",
      "tool": "Bash",
      "command": "sudo rm -rf /*",
      "expect": "deny"
    },
    {
      "id": "deny-rm-rf-home-tilde",
      "tool": "Bash",
      "command": "rm -rf ~",
      "expect": "deny"
    },
    {
      "id": "deny-rm-rf-home-var",
      "tool": "Bash",
      "command": "rm -rf \"$HOME\"",
      "expect": "deny"
    },
    {
      "id": "deny-rm-rf-cwd",
      "tool": "Bash",
      "command": "rm -rf .",
      "expect": "deny"
    },
    {
