{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "types/**/*",
    "runtime/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    ".agent-sdlc"
  ]
}