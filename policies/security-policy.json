{
  "schema": "agent-sdlc/security-policy/v1",
  "version": "3.0.0-alpha6",
  "network_default": "deny",
  "repo_content_trust": "untrusted-data",
  "human_approval_required": [
    "deploy.production",
    "destructive_database_change",
    "credential_or_iam_change",
    "network_perimeter_change",
    "data_deletion",
    "security_exception",
    "compliance_exception",
    "release_signing",
    "irreversible_action"
  ],
  "secret_policy": "no ambient production credentials; prefer short-lived scoped credentials",
  "secret_scan": {
    "note": "A finding must be a credential-shaped VALUE, not a name followed by punctuation. Regexes are POSIX ERE: they are handed to `git grep -E`, where \\s is not portable.",
    "patterns": [
      {"id": "AWS_ACCESS_KEY_ID", "regex": "AKIA[0-9A-Z]{16}"},
      {"id": "PRIVATE_KEY_BLOCK", "regex": "BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY"},
      {"id": "STRIPE_API_KEY", "regex": "(sk|pk|rk)_(live|test)_[0-9a-zA-Z]{24,}"},
      {"id": "DATABASE_URI_CREDENTIAL", "regex": "(postgres|postgresql|mysql|mongodb|redis|amqp)://[^/ :@]+:[^/ :@]+@[^/ :]+"},
      {"id": "ANTHROPIC_API_KEY", "regex": "sk-ant-[A-Za-z0-9_./+-]{32,}"},
      {"id": "OPENAI_API_KEY", "regex": "sk-proj-[A-Za-z0-9_./+-]{32,}"},
      {"id": "GITHUB_PAT", "regex": "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}"},
      {"id": "GITHUB_FINE_GRAINED_PAT", "regex": "github_pat_[A-Za-z0-9_]{82}"},
      {"id": "SLACK_API_TOKEN", "regex": "xox[baprs]-[0-9a-zA-Z]{10,48}"},
      {"id": "SUPABASE_API_KEY", "regex": "sbp_[a-zA-Z0-9]{32,}"},
      {"id": "GOOGLE_API_KEY", "regex": "AIza[0-9A-Za-z_./+-]{35}"},
      {"id": "ASSIGNED_CREDENTIAL", "regex": "(api[_-]?key|secret|token|password|passwd)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9_./+-]{8,}"}
    ],
    "allowlist_paths": [
      "evals/**",
      "docs/superpowers/specs/**",
      "docs/superpowers/plans/**"
    ]
  },
  "protected_paths": [
    ".github/workflows/**",
    ".agent-sdlc/policies/**",
    "agent-sdlc.manifest.json"
  ],
  "sensitive_read_patterns": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "id_rsa",
    "id_ed25519",
    ".aws/**",
    ".ssh/**",
    ".npmrc",
    ".pypirc",
    ".git/config",
    ".git/credentials",
    ".git-credentials",
    ".netrc",
    "_netrc"
  ],
  "web_search_policy": {
    "blocked_query_patterns": [
      "(?i)api[_-]?key",
      "(?i)secret",
      "(?i)password",
      "(?i)token",
      "(?i)bearer\\s+[a-z0-9_.-]+",
      "(?i)AKIA[0-9A-Z]{16}",
      "(?i)BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY"
    ],
    "blocked_host_patterns": [
      "localhost",
      "127.0.0.1",
      "10.*",
      "192.168.*",
      "172.16.*",
      "*.local",
      "*.internal",
      "*.corp"
    ]
  }
}
