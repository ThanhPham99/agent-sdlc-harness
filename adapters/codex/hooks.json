{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|shell|shell_command|exec_command|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pretool-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Agent SDLC policy check"
          }
        ]
      }
    ]
  }
}
