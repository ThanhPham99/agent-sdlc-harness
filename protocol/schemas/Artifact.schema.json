{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-sdlc/Artifact/v1",
  "title": "Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "kind",
    "sha256",
    "path",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "bindings": {
      "type": "array",
      "description": "One entry per distinct put of this content. The object store is content-addressed and shared across runs, so identical bytes are one object that more than one run may have stored; the top-level kind/run_id/stage/source_revision mirror the first binding.",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
