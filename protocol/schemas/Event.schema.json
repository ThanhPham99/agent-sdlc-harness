{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-sdlc/Event/v1",
  "title": "Event",
  "type": "object",
  "required": [
    "event_id",
    "run_id",
    "seq",
    "type",
    "time"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "type": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object"
    }
  }
}
