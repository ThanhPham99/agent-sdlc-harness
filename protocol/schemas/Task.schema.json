{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-sdlc/task/v1",
  "title": "Task",
  "description": "A first-class runtime task record. Durable, independently verifiable, and the only thing a writer agent is authorized to change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "run_id",
    "plan_id",
    "title",
    "goal",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "agent-sdlc/task/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3,}$"
    },
    "run_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "category": {
      "enum": [
        "implementation",
        "migration",
        "verification",
        "security",
        "integration",
        "documentation",
        "release",
        "operability"
      ]
    },
    "status": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "VERIFYING",
        "SPEC_REVIEW",
        "QUALITY_REVIEW",
        "DONE",
        "BLOCKED",
        "FAILED",
        "INVALIDATED",
        "SUPERSEDED"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "design_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_behavior": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targeted_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_behavior": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "done_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": [
            "FAST",
            "STANDARD",
            "STRICT"
          ]
        },
        "security": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "data": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "destructive_data_change": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fresh_context": {
          "type": "boolean"
        },
        "isolated_workspace": {
          "type": "boolean"
        },
        "workspace_mode": {
          "enum": [
            "shared-readonly",
            "isolated-worktree",
            "provider-sandbox"
          ]
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "primary_writer": {
          "type": [
            "string",
            "null"
          ]
        },
        "independent_review": {
          "type": "boolean"
        },
        "parallel_candidate": {
          "type": "boolean"
        },
        "estimated_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "base_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "diff_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_manifest_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "type": "string"
        }
      }
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      }
    },
    "invalidation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "time": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "time"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt": {
            "type": "integer"
          },
          "time": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
