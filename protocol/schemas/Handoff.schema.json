    "objective": {
      "type": "string"
    },
    "decisions": {
      "type": "array"
    },
    "files": {
      "type": "array"
    },
    "contracts": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "next_action": {
      "type": "string"
    }
  }
