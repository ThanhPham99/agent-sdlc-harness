{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-sdlc/StageResult/v1",
  "title": "StageResult",
  "type": "object",
  "required": [
    "status",
    "summary",
    "evidence"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NEEDS_CONFIRMATION"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
